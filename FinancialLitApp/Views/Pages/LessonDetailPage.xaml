<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FinancialLitApp.Views.Pages.LessonDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Lessons"
             BackgroundColor="#0D1738">
   
    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            <!--Page Header for the Lesson details-->
        
            <Label Text="Financial Concepts Lessons"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#FFEBD7"
                   HorizontalOptions="Center"
                   Margin="0,10,20,0"/>

            <Label Text="Improve your financial knowledge below:"
                   FontSize="16"
                   TextColor="#FFEBD7"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30"/>
            
            
            <!--Lessons Detail Containers-->
            <!--Savings Challenge Lesson -->
            <StackLayout Spacing="20">
                <Frame BackgroundColor="#103D81"
                        CornerRadius="20"
                        Padding="0"
                        HasShadow="True">
                    <Button x:Name="SavingsLesson"
                             Text="💰 Savings Lesson"
                             BackgroundColor="Transparent"
                             TextColor="#FFEBD7"
                             FontSize="18"
                             FontAttributes="Bold"
                             HeightRequest="60"
                             Clicked="OnSavingsLessonClicked"/>
                </Frame>
                <!--Budeting Challenge Lesson -->
                <Frame BackgroundColor="#103d81"
                       CornerRadius="20"
                       Padding="0"
                       HasShadow="True">
                    <Button x:Name="BudgetingLesson"
                               Text="📊 Budgeting Lesson"
                               BackgroundColor="Transparent"
                               TextColor="#FFEBD7"
                               FontSize="18"
                               FontAttributes="Bold"
                               HeightRequest="60"
                               Clicked="OnBudgetingLessonClicked"/>
                </Frame>

                <Frame BackgroundColor="#103d81"
                       CornerRadius="20"
                       Padding="0"
                       HasShadow="True">
                    <Button x:Name="FilingTaxReturns"
                            Text="Filing Tax Returns Lesson"
                            BackgroundColor="#103d81"
                            TextColor="#FFEBD7"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="60"
                            WidthRequest="250"
                            Clicked="OnFilingTaxReturnsClicked"/>

                </Frame>


            </StackLayout>
           
        </StackLayout>
    </ScrollView>
        
   
</ContentPage>