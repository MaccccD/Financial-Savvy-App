<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FinancialLitApp.Views.Pages.Lessons.FinancialPortfolio"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Filing Tax Returns Section"
             BackgroundColor="#0D1738">


    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <!---The header section of the lesson content-->

            <Frame BackgroundColor="#16213e" CornerRadius="15" Padding="20">
                <StackLayout Spacing="10">
                    <Label Text="Let's get you tax return savvy!"
                         FontSize="30"
                         FontAttributes="Bold"
                         TextColor="#00d4aa"
                         HorizontalOptions="Center"/>
                    <Label Text="Discover the importance of filing your taxes and the financial value it has."
                         FontSize="14"
                         TextColor="#ffebd7"
                         HorizontalOptions="Center"
                         LineBreakMode= "WordWrap"/>
                </StackLayout>
            </Frame>
            <!---the key insights section where user actually receive the understanding":-->

            <Frame BackgroundColor="#16213e" CornerRadius="15" Padding="18">
                <StackLayout Spacing="12">
                    <Label Text=" 🧠 Mind-Blowing Fact(s):"
                     FontSize="18"
                     FontAttributes="Bold"
                     TextColor="LimeGreen"/>
                    <Label Text="Most young people have NO IDEA how to file tax returns untill they are forced to!"
                     FontSize="18"
                     FontAttributes="Bold"
                     LineBreakMode="WordWrap"
                     TextColor="#ffebd7"/>
                    <Label Text="Infact, filing tax returns is one of the most intimidating financial tasks for Gen Z."
                           FontSize="15"
                           TextColor="#ffebd7"
                           HorizontalOptions="Start"
                           LineBreakMode="WordWrap"/>
                    <Label Text="So how can we bridge the gap between this intimidating fear and such financial tasks?"
                           FontSize="15"
                           TextColor="#ffebd7"
                           HorizontalOptions="Start"
                           LineBreakMode="WordWrap"/>
                </StackLayout>
            </Frame>

            <!---Understanding what tax returns are and why they are important to understand.:-->
            <Frame BackgroundColor="#16213e" CornerRadius="12" Padding="18">
                <StackLayout Spacing="15">
                    <Label Text=" 🍃 What are Tax Returns ?"
                         FontSize="18"
                         FontAttributes="Bold"
                         TextColor="Limegreen"
                         LineBreakMode="WordWrap"/>
                    <!--- explaining the meaning of it :-->
                    <StackLayout Orientation="Vertical" Spacing="12">
                        <Frame BackgroundColor="#103d81" CornerRadius="8" Padding="12" HorizontalOptions="StartAndExpand">
                            <StackLayout>
                                <Label Text="Tax Returns are official documents/forms that you submitted to the government (SARS in South Africa) to report your income, expenses and other financial information you have."
                                     FontSize="15"
                                     TextColor="#ffebd7"
                                     VerticalOptions="Center"
                                     LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </Frame>

                        <Frame BackgroundColor="#103d81" CornerRadius="8" Padding="12" HorizontalOptions="StartAndExpand">
                            <StackLayout>
                                <Label Text="They are important for every employed citizen in SA to pay because they act as a way for all citizens to collectively fund the society we all live in. This includes funding public services , infrastructure, future safety and security as well as redistribution."
                                   FontSize="15"
                                   TextColor="#ffebd7"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </Frame>

                        <Frame BackgroundColor="#103d81" CornerRadius="8" Padding="12" HorizontalOptions="StartAndExpand">
                            <StackLayout Spacing="5">
                                <Label Text="The document/form that is then submitted to SARS in South Africa is called an Income Tax Return 12(ITR12)."
                                       TextColor="#ffebd7"
                                       FontSize="15"
                                       HorizontalOptions="CenterAndExpand"
                                       LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </Frame>

                        <Frame BackgroundColor="#103d81" CornerRadius="8" Padding="12" HorizontalOptions="StartAndExpand">
                            <StackLayout Spacing="5">
                                <Label Text="The ITR12 form can found on the SARS eFiling System and it is a form that SARS requires for all employed individuals to complete and submit to SARS once every year to reconcile their tax liability."
                                       TextColor="#ffebd7"
                                       FontSize="15"
                                       HorizontalOptions="CenterAndExpand"
                                       LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- The steps to take when completing an ITR12 form in order to file the tax return :-->
            <Frame BackgroundColor="#16213e" CornerRadius="12" Padding="8">
                <StackLayout Spacing="15">
                    <Label Text="🪜 The following are the steps that a non-provisional tax payer (individual) takes to commplete their ITR12 form:"
                           FontSize="15"
                           TextColor="LimeGreen"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"/>
                    <!---The actual steps:-->
                    <Frame BackgroundColor="#103d81" CornerRadius="8" Padding="12" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="1. Register for eFiling as a new user(Individal) (or tax practitioner) on their website : go to www.sarsefiling.co.za "
                                   FontSize="15"
                                   TextColor="#ffebd7"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="#103d81" CornerRadius="8" Padding="12" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="2. Read through the eFiling terms and conditions and accept them to proceed."
                                   FontSize="15"
                                   TextColor="#ffebd7"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="#103d81" CornerRadius="12" Padding="8" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="3. For an indidivual tax payer, complete all individual personal details such as tax reference number, Id number etc. "
                                   FontSize="15"
                                   TextColor="#ffebd7"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="#103d81" CornerRadius="12" Padding="8" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="4. Click Regsiter and then be redirected to the Income Tax Work Page."
                                   FontSize="15"
                                   TextColor="#ffedb7"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="#103d81" CornerRadius="12" Padding="8" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="5. Click on the 'ITR12' on the left. This will open up a 'wizard' where youl'll be able to create a customized ITR12 return."
                                   FontSize="15"
                                   LineBreakMode="WordWrap"
                                   TextColor="#ffebd7"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="#103d81" CornerRadius="12" Padding="8" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="6. After completing what is needed on the wizard, you can then click on'Save Return' and then proceed to do your calculation by clicking on 'Tax Calculator'"
                                   FontSize="15"
                                   LineBreakMode="WordWrap"
                                   TextColor="#ffebd7"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <Frame BackgroundColor="#103d81" CornerRadius="12" Padding="8" HorizontalOptions="StartAndExpand">
                        <StackLayout>
                            <Label Text="7. Once you have captured all the information on your ITR12 return and are ready to submit to SARS, simply click File Return."                                   FontSize="15"                                   LineBreakMode="WordWrap"                                   TextColor="#ffebd7"                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <Label Text="This financial information is brought to you by SARS eFiling(2025). (https://share.google/NFYZPMG7x1j66dyE6)"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#FFEBD7"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="Center"/>

                         <!--- The challenge btn to navigate user to the actual gameplay challenge:-->
                    <Button Text="🚀 Try this Tax Return Challenge!"
					        BackgroundColor="#2503FD"
					        TextColor="#ffebd7"
					        Margin="8"
					        CornerRadius="10"
					        HeightRequest="60"
					        WidthRequest="270"
					        FontSize="15"
					        FontAttributes="Bold"
					        Clicked="OnTaxReturnChallengeClicked"/>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>