<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FinancialLitApp.Views.Pages.Challenges.Savings"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialLitApp.ViewModels"
             Title="Savings Challenge"
             BackgroundColor="#1a1a2e">
    <ContentPage.BindingContext>
        <vm:SavingsChallengeViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Frame BackgroundColor="#16213e" CornerRadius="10" Padding="15">
                <StackLayout>
                    <Label Text="Savings Challenge"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="AntiqueWhite"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding CurrentAttempt, StringFormat='Attempt: {0} of 3'}"
                           FontSize="16"
                           TextColor="#00d4aa"
                           HorizontalOptions="Center"/>

                </StackLayout>
            </Frame>
            <Frame BackgroundColor="#34495e" CornerRadius="8" Padding="15" Margin="0,20,0,0">
                <StackLayout>
                    <Label Text="How it Works" FontSize="20" FontAttributes="Bold" TextColor="AntiqueWhite"/>
                    <Label Text="In this challenge, players need to  make strategic spending decisions to reach their savings target goal.  They can do this by selecting from items categorized as Needs or Wants. Players win  when their remaining funds equal the target savings amount, with 3 attempts available to succeed."
                 FontSize="16"
                 TextColor="#ecf0f1"
                 LineBreakMode="WordWrap"/>
                </StackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" RowDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">

                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="8" Padding="10">
                    <StackLayout>
                        <Label Text="1. Starting Amount: " FontSize="12" TextColor="#ff6b6b" FontAttributes="Bold"/>
                        <Label Text="{Binding StartingAmount, StringFormat='R{0:F0}'}" FontSize="16" TextColor="Black"/>
                    </StackLayout>
                </Frame>
        

            <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White" CornerRadius="10">
                <StackLayout>
                    <Label Text="2. Currently Saved: " FontSize="12" TextColor="#ff6b6b" FontAttributes="Bold"/>
                    <Label Text="{Binding CurrentlySaved, StringFormat='R{0:F0}'}" FontSize="16" TextColor="Black" />
                </StackLayout>
            </Frame>
            

            <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="White" CornerRadius="8" Padding="10">
                <StackLayout>
                    <Label Text="3. Money Spent: " FontSize="12" TextColor="#ff6b6b" FontAttributes="Bold"/>
                    <Label Text="{Binding MoneySpent, StringFormat='R{0:F0}'}" FontSize="16" TextColor="Black"/>
                </StackLayout>
            </Frame>
            
            <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="White" CornerRadius="8" Padding="10">
                <StackLayout>
                    <Label Text="4. Target Savings: " FontSize="12" TextColor="#28a745" FontAttributes="Bold"/>
                    <Label Text="{Binding TargetAmount, StringFormat='R{0:F0}'}" FontSize="16" TextColor="#28a745"/>
                </StackLayout>
            </Frame>
            </Grid>
            <Frame BackgroundColor="#2c3e50" CornerRadius="8" Padding="15" IsVisible="{Binding FeedbackMessage, Converter={StaticResource StringToBoolConverter}}">
                <Label Text="{Binding FeedbackMessage}"
                       FontSize="14"
                       TextColor="AntiqueWhite"
                       LineBreakMode="WordWrap"/>
            </Frame>
            <StackLayout>
                <Label Text="Select items to purchase:" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="AntiqueWhite"  
                       Margin="0,10,0,5"/>

                <FlexLayout Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Start"
                            Wrap="Wrap"
                            Margin="0,20,0,0">


                    <Frame BackgroundColor="#34495e" 
                       CornerRadius="8" 
                       Padding="8" 
                       Margin="10,0,10,0" 
                       MinimumWidthRequest="300" 
                       FlexLayout.Grow="1"
                       FlexLayout.Basis="45%"
                       HeightRequest="450">
                        <StackLayout>
                        <Label Text="NEEDS" 
                               FontSize="16" 
                               Margin="10,10,0,0" 
                               FontAttributes="Bold" 
                               TextColor="AntiqueWhite" 
                               HorizontalOptions="CenterAndExpand"/>
                        <CollectionView ItemsSource="{Binding AvailableItems}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout 
                                    Orientation="Vertical" 
                                    Span="2" 
                                    HorizontalItemSpacing="10" 
                                    VerticalItemSpacing="15"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <ContentView>
                                        <Frame Background="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#2c3e50|#2c3e50'}"
                                               CornerRadius="8"
                                               Padding="5"
                                               IsVisible="{Binding Category, Converter={StaticResource CategoryToVisibilityConverter}, ConverterParameter='Need'}">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavingsChallengeViewModel}}, Path=SelectItemCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Frame.GestureRecognizers>
                                            <StackLayout Spacing="5">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="AntiqueWhite"/>
                                                <Label Text="{Binding Price, StringFormat='R{0:F0}'}" FontSize="14" TextColor="#ecf0f1"/>
                                                <Label Text="{Binding Description}" FontSize="10" TextColor="#bdc3c7" LineBreakMode="WordWrap"/>
                                                <Label Text="{Binding IsSelected, Converter={StaticResource BoolToStringConverter},ConverterParameter='✅ Selected| '}"
                                                       FontSize="14"
                                                       TextColor="#e74c3c"
                                                       FontAttributes="Bold"
                                                       IsVisible="{Binding IsSelected}"/>

                                            </StackLayout>
                                        </Frame>
                                    </ContentView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
            </StackLayout>
            </Frame>

            <Frame  BackgroundColor="#34495e" 
                        CornerRadius="8" 
                        Margin="10,0,10,10" 
                        Padding="8"
                        MinimumWidthRequest="500" 
                        HeightRequest="450" 
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="45%">
                <StackLayout>
                    <Label Text="WANTS" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#ecf0f1" 
                               HorizontalOptions="Center" 
                               Margin="0,0,0,0"/>
                    <CollectionView ItemsSource="{Binding AvailableItems}"
                                        SelectionMode="None"
                                         Margin="15,-130,0,10"
                                        VerticalOptions="FillAndExpand">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" 
                                                 Span="2" 
                                                 HorizontalItemSpacing="10" 
                                                 VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView>
                                    <Frame BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#2c3e50|#2c3e50'}"
                                               CornerRadius="8"
                                               Padding="5"
                                               HeightRequest="85"
                                               Margin="0,0,10,80"
                                               IsVisible="{Binding Category, Converter={StaticResource CategoryToVisibilityConverter},ConverterParameter='Want'}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavingsChallengeViewModel}}, Path=SelectItemCommand}"
                                                                     CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <StackLayout Spacing="2" VerticalOptions="FillAndExpand">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#ecf0f1" HorizontalTextAlignment="Start" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Price, StringFormat='R{0:F0}'}" FontSize="12" TextColor="#bdc3c7"/>
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="#bdc3c7" LineBreakMode="WordWrap" HorizontalOptions="StartAndExpand"/>
                                            <Label Text="{Binding IsSelected, Converter={StaticResource BoolToStringConverter}, ConverterParameter='✅ Selected| '}"
                                                       FontSize="12"
                                                       TextColor="#e74c3c"
                                                       FontAttributes="Bold"
                                                       IsVisible="{Binding IsSelected}"/>
                                        </StackLayout>
                                    </Frame>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>
         </FlexLayout>
       </StackLayout>

            
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Spacing="10">
                <Button Text="Check Result"
                        Command="{Binding CheckResultCommand}"
                        BackgroundColor="DarkGreen"
                        TextColor="AntiqueWhite"
                        CornerRadius="8"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"
                        IsEnabled="{Binding IsGameActive}"/>

                <Button Text="Reset"
                        Command="{Binding ResetChallengeCommand}"
                        BackgroundColor="MidnightBlue"
                        TextColor="AntiqueWhite"
                        CornerRadius="8"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"/>

            </StackLayout>

            <Frame BackgroundColor="#2c3e50"
                   CornerRadius="10"
                   Padding="20"
                   IsVisible="{Binding ShowResults}"
                   Margin="0,10,0,0">
                <StackLayout Spacing="15">
                   <Label Text="Challenge Results"
                          FontSize="20"
                          FontAttributes="Bold"
                          TextColor="#00d4aa"
                          HorizontalOptions="Center"/>

                   <Label Text="{Binding FeedbackMessage}"
                          FontSize="16"
                          TextColor="AntiqueWhite"
                          LineBreakMode="WordWrap"/>

                    <Button Text="Try Another Challenge"
                            Command="{Binding ResetChallengeCommand}"
                            BackgroundColor="#00d4aa"
                            TextColor="AntiqueWhite"
                            CornerRadius="8"
                            HeightRequest="45"/>

                </StackLayout>
            </Frame>

          


        </StackLayout>
    </ScrollView>
</ContentPage>