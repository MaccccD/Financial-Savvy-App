<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FinancialLitApp.Views.Pages.Challenges.Budgeting"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialLitApp.ViewModels"
              xmlns:converters="clr-namespace:FinancialLitApp.Converters"
             Title="Budgeting Challenge"
             BackgroundColor="#0D1738">
    <ContentPage.BindingContext>
        <vm:BudgetingChallengeViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            <Frame BackgroundColor="#1a237e" CornerRadius="15" Padding="20">
                <StackLayout>
                    <Label Text="Budgeting Challenge"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding CurrentAttempt, StringFormat='Attempt: {0} of 3'}"
                           FontSize="16"
                           TextColor="#00d4aa"
                           HorizontalOptions="Center"
                           Margin="0,5,0,0"/>
                </StackLayout>
            </Frame>
            
            
            <!---The 3 metrics dashboard layout:-->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                
                <!---Starting Amount-->
                <Frame Grid.Column="0" BackgroundColor="AntiqueWhite" CornerRadius="10" Padding="12" HasShadow="True">
                    <StackLayout Spacing="5">
                        <Label Text="1️⃣" FontSize="18" HorizontalOptions="Center"/>
                        <Label Text="Starting Allowance:" FontSize="12" TextColor="Limegreen" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding StartingAmount, StringFormat='R{0:F0'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <!---Current Cost spent on expenses layout-->
                    <Frame Grid.Column="1" BackgroundColor="AntiqueWhite" Padding="12" CornerRadius="10" HasShadow="True">
                        <StackLayout Spacing="5">
                            <Label Text="2️⃣" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding CurrentCostsSpent, StringFormat='R{0:F0'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                
                <!--TargetSavinngs-->
                <Frame Grid.Column="2" BackgroundColor="AntiqueWhite" CornerRadius="10" Padding="12" HasShadow="True">
                    <StackLayout Spacing="5">
                        <Label Text="3️⃣" FontSize="18" HorizontalOptions="Center"/>
                        <Label Text="{Binding TargetSavings, StringFormat='R{0:F0'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>
            </Grid>
            
            <!---Warning Messages visuals -->
            <Frame BackgroundColor="#34495e"
                   CornerRadius="10"
                   Padding="15"
                   IsVisible="{Binding WarningMessage, Converter={StaticResource StringIsNotEmptyConverter}}">
                <Label Text="{Binding WarningMessage}"
                    FontSize="14"
                    TextColor="#ffebd7"
                    HorizontalOptions="Center"
                    LineBreakMode="WordWrap"/>
            </Frame>

            <Frame BackgroundColor="#2c3e50"
                   CornerRadius="10"
                   Padding="15"
                   IsVisible="{Binding FeedbackMessage, Converter={StaticResource StringIsNotEmptyConverter}}">
                <Label Text="{Binding FeedbackMessage}"
                       FontSize="14"
                       TextColor="#00d4aa"
                       LineBreakMode="WordWrap"/>
            </Frame>
            
            <!--Expenses section :-->
            <Label Text="Choose your expenses wisely!"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#ffebd7"
                   HorizontalOptions="Center"/>
            
            <!--The impulse purchases-->
            <Frame BackgroundColor="#e74c3c" CornerRadius="13" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="💸 Impulse Purchases"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>
                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="SpaceEvenly"
                                AlignItems="Start">
                        <CollectionView ItemsSource="{Binding AvailableExpenses}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="#c0392b"
                                           CornerRadius="8"
                                           Padding="12"
                                           IsVisible="{Binding isSelected, Converter={StaticResource InverseBoolConverter}}"
                                           Margin="5">
                                        <StackLayout Spacing="8">
                                            <!---So only show  the item has not been spend on yet , but after hide it:-->
                                            <StackLayout.IsVisible>
                                                <Binding Path="category">
                                                    <Binding.Converter>
                                                        <converters:CategoryFilterConverter CategoryFilter="ImpulsePurchase"/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </StackLayout.IsVisible>
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#ffebd7"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding Price, StringFormat='R{0}'}"
                                                   FontSize="13"
                                                   TextColor="#ffebd7"/>
                                            <Button Text="Spend"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetingChallengeViewModel}}, Path=SpendOnItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#219DC6"
                                                    TextColor="#ffebd7"
                                                    CornerRadius="6"
                                                    FontSize="12"
                                                    HeightRequest="35"
                                                    FontAttributes="Bold"/>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </FlexLayout>
                </StackLayout>
            </Frame>
            
            <!--Needs-->
            <Frame BackgroundColor="#27ae60" CornerRadius="12" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="✅ NEEDS"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding AvailableExpenses}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#229954"
                                       CornerRadius="8"
                                       Padding="12"
                                       IsVisible="{Binding isSelected, Converter={StaticResource InverseBoolConverter}}"
                                       Margin="5">
                                    <StackLayout Spacing="8">
                                        <StackLayout.IsVisible>
                                            <Binding Path="category">
                                                <Binding.Converter>
                                                    <converters:CategoryFilterConverter CategoryFilter="Need"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </StackLayout.IsVisible>
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#ffebd7"
                                               LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding Price, StringFormat='R{0}'}"
                                               FontSize="13"
                                               TextColor="#ffebd7"/>

                                        <Button Text="Spend"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetingChallengeViewModel}}, Path=SpendOnItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#219DC6"
                                                TextColor="#ffebd7"
                                                CornerRadius="6"
                                                FontSize="12"
                                                HeightRequest="35"
                                                FontAttributes="Bold"/>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>
            
            <!---Wants-->
            <Frame  BackgroundColor="#f39c12" CornerRadius="12" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="🎯 WANTS"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>
                    <CollectionView ItemsSource="{Binding AvailableExpenses}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#e67e22"
                                       CornerRadius="8"
                                       Padding="12"
                                       IsVisible="{Binding isSelected, Converter={StaticResource InverseBoolConverter}}"
                                       Margin="5">
                                    <StackLayout Spacing="8">
                                        <StackLayout.IsVisible>
                                            <Binding Path="category">
                                                <Binding.Converter>
                                                    <converters:CategoryFilterConverter CategoryFilter="Want" />
                                                </Binding.Converter>
                                            </Binding>
                                        </StackLayout.IsVisible>

                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#ffebd7"
                                               LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding Price, StringFormat='R{0}'"
                                               FontSize="13"
                                               TextColor="#ffebd7"/>
                                        <Button Text="{Binding Name}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetingChallengeViewModel}}, Path=SpendOnItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#219DC6"
                                                TextColor="#f39c12"
                                                CornerRadius="6"
                                                FontSize="12"
                                                HeightRequest="35"
                                                FontAttributes="Bold"/>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>
            
            <!---Investments-->
            <Frame BackgroundColor="#9b59b6" CornerRadius="12" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="📈 INVESTMENTS"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding AvailableExpenses}"
                                    SelectionMode="None"
                                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#8e44ad"
                                       CornerRadius="8"
                                       Padding="12"
                                       IsVisible="{Binding isSelected, Converter={StaticResource InverseBoolConverter}}"
                                       Margin="5">
                                    <StackLayout Spacing="8">
                                        <StackLayout.IsVisible>
                                            <Binding Path="category">
                                                <Binding.Converter>
                                                    <converters:CategoryFilterConverter CategoryFilter="Investment"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </StackLayout.IsVisible>

                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#ffebd7"
                                               LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding Price, StringFormat='R{0}'}"
                                               FontSize="13"
                                               TextColor="#ffebd7"/>

                                        <Button Text="Spend"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetingChallengeViewModel}}, Path=SpendOnItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#219DC6"
                                                TextColor="#ffebd7"
                                                CornerRadius="6"
                                                FontSize="12"
                                                HeightRequest="35"
                                                FontAttributes="Bold"/>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>
            
            <!-- the actions btns-->
            <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Text="Check Budget"
                        Command="{Binding CheckBudgetCommand}"
                        BackgroundColor="LimeGreen"
                        TextColor="#ffebd7"
                        CornerRadius="10"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="FillAndExpand"
                        IsEnabled="{Binding IsGameActive}"/>

                <Button Text="Reset"
                        Command="{Binding ResetChallengeCommand}"
                        BackgroundColor="DeepSkyBlue"
                        TextColor="#ffebd7"
                        CornerRadius="10"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="FillAndExpand"/>
            </StackLayout>
            
            <!--- the results layout display-->
            <Frame BackgroundColor="#2c3e50"
                   CornerRadius="12"
                   IsVisible="{Binding ShowResults}"
                   Margin="0,10,0,20">
                <StackLayout Spacing="15">
                    <Label Text="📊 Challenge Results"
                           FontSize="14"
                           FontAttributes="Italic"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding FeedbackMessage}"
                           FontSize="14"
                           TextColor="#ffebd7"
                           LineBreakMode="WordWrap" />

                    <Button Text="Try Another Challenge"
                            Command="{Binding ResetChallengeCommand}"
                            BackgroundColor="#00d4aa"
                            TextColor="#ffebd7"
                            CornerRadius="10"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"/>
                </StackLayout>
            </Frame>
            
            
        </StackLayout>
    </ScrollView>
</ContentPage>