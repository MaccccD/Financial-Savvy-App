<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FinancialLitApp.Views.Pages.Challenges.FilingTaxReturns"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialLitApp.ViewModels"
             xmlns:converters="clr-namespace:FinancialLitApp.Converters"
             Title="Filing Tax Returns Challenge"
             BackgroundColor="#0D1738">
    <ContentPage.BindingContext>
        <vm:FilingTaxReturnsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="20" Spacing="10">
            <!--- Header-->
            <Frame BackgroundColor="#1a2e73" CornerRadius="15" Padding="20">
                <StackLayout>
                    <Label Text="Filing Tax Returns Challenge"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>


                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>