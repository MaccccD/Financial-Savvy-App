<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FinancialLitApp.Views.Pages.Challenges.FilingTaxReturns"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialLitApp.ViewModels"
             xmlns:converters="clr-namespace:FinancialLitApp.Converters"
             Title="Filing Tax Returns Challenge"
             BackgroundColor="#0D1738">
	<ContentPage.BindingContext>
		<vm:FilingTaxReturnsViewModel />
	</ContentPage.BindingContext>

	<ScrollView>
		<StackLayout Padding="20" Spacing="10">
			<!--- Header-->
			<Frame BackgroundColor="#1a2e73" CornerRadius="15" Padding="20">
				<StackLayout>
					<Label Text="Filing Tax Returns Challenge"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>
					<Label Text="{Binding CurrentAttempt, StringFormat='Attempt:{0} of 3'}"
                           FontSize="15"
                           TextColor="#00d4aa"
                           HorizontalOptions="Center"
                           Margin="0,5,0,0"/>
				</StackLayout>
			</Frame>
            
            <!--- How it works :-->

            <Frame BackgroundColor="#34495e" CornerRadius="12" Padding="18">
                <StackLayout Spacing="10">
                    <Label Text="How It Works:"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#00d4aa"/>
                    <Label Text="In this challenge, you'll learn how to file your tax returns by completing this mock ITR12 Form. Use the formulas given to calculate each amount. The aim is to understand how the tax calculator works and what deductions are applied to your salary."
                           FontSize="14"
                           TextColor="#ffebd7"
                           LineBreakMode="WordWrap"/>


                    <Label Text="💡 Why This Matters?"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#00d4aa"
                           Margin="0,10,0,0"/>
                    <Label Text="-Every South African earning above R91,250 per year must file tax returns. Understanding deductions helps you verify your payslip. You can maximize tax benefits (like pension contributions) and avoid penalties for incorrect or late filing."
                           FontSize="15"
                           TextColor="#ffebd7" 
                           LineBreakMode="WordWrap"/>
                </StackLayout>
            </Frame>


            <Frame Background="#34495e" CornerRadius="8" Padding="12">
                <StackLayout Spacing="12">
                    <Label Text="{Binding OverallMessage}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Yellow"
                       HorizontalOptions="Center" />
                </StackLayout>
            </Frame>
            
            
            <!--- The ITR12-->
			<Frame BackgroundColor="#34495e" CornerRadius="12" Padding="20" HasShadow="True">
				<StackLayout Spacing="15">

					<!---the title-->
					<Label Text="ITR12 Form"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#ffebd7"
                           HorizontalOptions="Center"/>

					<!--- Gross & net Info-->
					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="20" Margin="0,10">
						<StackLayout Grid.Column="0">
							<Label Text="Annual Gross Salary: " FontSize="16" TextColor="Gray"/>
							<Label Text="{Binding GrossSalaryAnnual, StringFormat='R{0:N2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#00d4aa"/>
						</StackLayout>
						<StackLayout Grid.Column="1">
							<Label Text="Monthly Gross Salary:" FontSize="16" TextColor="Gray"/>
							<Label Text="{Binding GrossSalaryMonthly, StringFormat='R{0:N2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#00d4aa"/>
						</StackLayout>
                        <StackLayout Grid.Column="2">
                            <Label Text="Nett-take home pay:" FontSize="16" TextColor="Gray"/>
                            <Label Text="{Binding NetTakeHomePay, StringFormat='R{0:N2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#00d4aa"/>
                        </StackLayout>


                    </Grid>

					<BoxView HeightRequest="2" Color="LightGray" Margin="0,10"/>

					<!---Table Headers-->

					<Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="5">
						<Label Grid.Column="0"
                               Text="Type of deduction"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="PeachPuff"/>
						<Label Grid.Column="1"
                               Text="Tax Bracket Formula"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="PeachPuff"/>
						<Label Grid.Column="2"
                               Text="Monthly Amount Taxable"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="PeachPuff"/>
					</Grid>

					<BoxView HeightRequest="1" Color="Gray"/>

					<!--- Paye ROW-->
					<Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="5">
						<StackLayout Grid.Column="0">
							<Label Text="PAYE" FontSize="15" FontAttributes="Bold" TextColor="#00d4aa"/>
							<Label Text="(Pay As You Earn) - income deducted from your salary"
								   FontSize="13"
						           TextColor="#ffebd7"
						           LineBreakMode="WordWrap"/>
						</StackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding PAYEFormulae}"
                               FontSize="13"
                               TextColor="#ffebd7"
                               LineBreakMode="WordWrap"/>
                        <Entry Grid.Column="2"
                               Text="{Binding PayeInput}"
                               TextColor="#ffebd7"
                               Keyboard="Numeric"
                               Placeholder="0.00"
                               FontSize="13"
                               BackgroundColor="#2c3e50"/>
                    </Grid>
                    
                    <!---Paye Feedback-->
                    <Frame BackgroundColor="#e3f2fd"
                           CornerRadius="8"
                           IsVisible="{Binding PayeFeedback, Converter={StaticResource StringIsNotEmptyConverter}}">
                        <Label Text="{Binding PayeFeedback}"
                                  FontSize="13"
                                  TextColor="#0d47a1"
                                  LineBreakMode="WordWrap"/>
                    </Frame>

                    <BoxView HeightRequest="1" Color="LightGray"/>
                    
                    <!---UIF Row -->
                    <Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="5">
                        <StackLayout Grid.Column="0">
                            <Label Text="UIF" FontSize="16" FontAttributes="Bold" TextColor="#00d4aa"/>
                            <Label Text="(Unemployment Insurance Fund Contribution)"
                                   FontSize="13"
                                   TextColor="#ffebd7"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding UIFFormulae}"
                               FontSize="13"
                               TextColor="#ffebd7"
                               LineBreakMode="WordWrap"/>
                        <Entry Grid.Column="2"
                               Text="{Binding UifInput}"
                               Keyboard="Numeric"
                               TextColor="#ffebd7"
                               Placeholder="0.00"
                               FontSize="14"
                               BackgroundColor="#2c3e50"/>
                    </Grid>
                    
                    <!--- UIF feedback-->
                    <Frame BackgroundColor="#e3f2fd"
                           CornerRadius="8"
                           IsVisible="{Binding UifFeedback, Converter={StaticResource StringIsNotEmptyConverter}}">
                        <Label Text="{Binding UifFeedback}"
                                  FontSize="13"
                                  TextColor="#0d47a1"
                                  LineBreakMode="WordWrap"/>
                    </Frame>

                    <BoxView HeightRequest="1" Color="LightGray"/>
                    
                    <!---Pension Fund Row-->
 
                    <Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="5">
                        <StackLayout Grid.Column="0">
                            <Label Text="Pension Fund" FontSize="16" FontAttributes="Bold" TextColor="#00d4aa"/>
                            <Label Text="(Retirement savings - tax deductible)"
                                   FontSize="13"
                                   TextColor="#ffebd7"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding PensionFundFormulae}"
                               FontSize="13"
                               TextColor="#ffebd7"
                               LineBreakMode="WordWrap"/>
                        <Entry Grid.Column="2"
                               Text="{Binding PensionFundInput}"
                               Keyboard="Numeric"
                               TextColor="#ffebd7"
                               Placeholder="0.00"
                               FontSize="14"
                               BackgroundColor="#2c3e50"/>
                    </Grid>

                    <!--- Pension fund feedback-->
                    <Frame BackgroundColor="#e3f2fd"
                           CornerRadius="8"
                           IsVisible="{Binding PensionFundFeedback, Converter={StaticResource StringIsNotEmptyConverter}}">
                        <Label Text="{Binding PensionFundFeedback}"
                            FontSize="13"
                            TextColor="#0d47a1"
                            LineBreakMode="WordWrap"/>
                    </Frame>

                    <BoxView HeightRequest="2" Color="Gray" Margin="0,10"/>
                    
                    <!---Total Deductions Row:-->
                    <Grid ColumnDefinitions="4*,*" ColumnSpacing="5">
                        <Label Grid.Column="0"
                               Text="Total Deductions"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#00d4aa"/>
                        <Label Grid.Column="1"
                               Text="{Binding CalculatedTotal, StringFormat='R{0:F2}'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#ffebd7"
                               HorizontalOptions="End"/>
                    </Grid>
                    
                    <!---Totall's feedback:-->
                    
                    <!-- Actions Bns-->
                    <Grid ColumnDefinitions="*" ColumnSpacing="10">
                        
                        <Button Grid.Column="1"
                                Text="File Return"
                                Command="{Binding FileReturnCommand}"
                                BackgroundColor="#2503FD"
                                TextColor="#ffebd7"
                                CornerRadius="10"
                                HeightRequest="50"
                                FontSize="16"
                                FontAttributes="Bold"/>
                    </Grid>
                    
                    <!---Overall Results-->
                    <Frame BackgroundColor="#2c3e50"
                           CornerRadius="12"
                           Padding="20"
                           IsVisible="{Binding ShowResults}">
                        <StackLayout Spacing="15">
                            <Label Text="📊 Results"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#00d4aa"
                                   HorizontalOptions="Center"/>

                             <Label Text="{Binding OverallMessage}"
                                    FontSize="15"
                                    TextColor="#ffebd7"
                                    LineBreakMode="WordWrap"/>

                            <Button Text="Try Again"
                                    Command="{Binding ResetCommand}"
                                    BackgroundColor="SkyBlue"
                                    TextColor="#ffebd7"
                                    CornerRadius="10"
                                    HeightRequest="45"
                                    FontSize="15"
                                    IsVisible="{Binding IsAllCorrect, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackLayout>
                    </Frame>
                </StackLayout>
			</Frame>

		</StackLayout>
	</ScrollView>
</ContentPage>